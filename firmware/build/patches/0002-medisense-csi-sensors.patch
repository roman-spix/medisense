diff --git a/firmware/esp32-csi-node/main/medisense_ppg.c b/firmware/esp32-csi-node/main/medisense_ppg.c
new file mode 100644
index 0000000..e056419
--- /dev/null
+++ b/firmware/esp32-csi-node/main/medisense_ppg.c
@@ -0,0 +1,172 @@
+/**
+ * @file medisense_ppg.c
+ * @brief MediSense: MAX3010x pulse sensor (red + IR) streamed to the host.
+ *
+ * WiFi can't measure heart rate reliably; a fingertip (or earlobe) optical
+ * pulse sensor can, including beat-to-beat intervals for heart-rate
+ * variability. The board only samples and forwards: all analysis (beats,
+ * HRV, finger detection) happens in the MediSense app.
+ *
+ * Sensor setup: SpO2 mode (red + IR), 400 samples/s averaged by 4 = 100 Hz,
+ * 411 us pulses (18-bit), 4096 nA range, ~7 mA LEDs. The FIFO (32 samples) is
+ * read every 50 ms, i.e. ~5 samples per UDP packet:
+ *
+ *   [magic u32 0xC511D0B1][node u8][type u8 = 1][n u8][channels u8 = 2]
+ *   [seq u32][dev_ts_us u32 (last sample)][rate_hz u16][flags u16 (bit0 = overflow)]
+ *   [n x (red u32, ir u32)]
+ */
+
+#include "medisense_ppg.h"
+
+#include <string.h>
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "driver/i2c_master.h"
+#include "stream_sender.h"
+#include "csi_collector.h"
+
+#ifndef MEDISENSE_PPG_SDA_GPIO
+#define MEDISENSE_PPG_SDA_GPIO 8
+#endif
+#ifndef MEDISENSE_PPG_SCL_GPIO
+#define MEDISENSE_PPG_SCL_GPIO 9
+#endif
+
+#define PPG_ADDR          0x57
+#define PPG_MAGIC         0xC511D0B1u
+#define PPG_RATE_HZ       100
+#define PPG_READ_MS       50
+#define PPG_FIFO_DEPTH    32
+
+/* MAX3010x registers */
+#define REG_FIFO_WR_PTR   0x04
+#define REG_OVF_COUNTER   0x05
+#define REG_FIFO_RD_PTR   0x06
+#define REG_FIFO_DATA     0x07
+#define REG_FIFO_CONFIG   0x08
+#define REG_MODE_CONFIG   0x09
+#define REG_SPO2_CONFIG   0x0A
+#define REG_LED1_PA       0x0C  /* red */
+#define REG_LED2_PA       0x0D  /* IR */
+#define REG_PART_ID       0xFF
+#define PART_ID_MAX3010X  0x15
+
+static const char *TAG = "medisense_ppg";
+static i2c_master_bus_handle_t s_bus = NULL;
+static i2c_master_dev_handle_t s_dev = NULL;
+
+static esp_err_t wr(uint8_t reg, uint8_t val)
+{
+    uint8_t b[2] = { reg, val };
+    return i2c_master_transmit(s_dev, b, 2, 50);
+}
+
+static esp_err_t rd(uint8_t reg, uint8_t *out, size_t n)
+{
+    return i2c_master_transmit_receive(s_dev, &reg, 1, out, n, 50);
+}
+
+static void ppg_task(void *arg)
+{
+    (void)arg;
+    static uint8_t raw[PPG_FIFO_DEPTH * 6];
+    static uint8_t pkt[20 + PPG_FIFO_DEPTH * 8];
+    uint32_t seq = 0;
+    uint32_t errors = 0;
+    TickType_t last = xTaskGetTickCount();
+
+    for (;;) {
+        vTaskDelayUntil(&last, pdMS_TO_TICKS(PPG_READ_MS));
+        uint8_t ptr[3];
+        if (rd(REG_FIFO_WR_PTR, ptr, 3) != ESP_OK) {  /* WR_PTR, OVF_COUNTER, RD_PTR */
+            if ((++errors % 100) == 1) ESP_LOGW(TAG, "I2C read failed (%lu)", (unsigned long)errors);
+            continue;
+        }
+        uint8_t wr_ptr = ptr[0] & 0x1F, ovf = ptr[1] & 0x1F, rd_ptr = ptr[2] & 0x1F;
+        int n = (wr_ptr - rd_ptr) & 0x1F;
+        if (ovf > 0) n = PPG_FIFO_DEPTH;  /* fell behind: the FIFO is full */
+        if (n == 0) continue;
+        if (rd(REG_FIFO_DATA, raw, (size_t)n * 6) != ESP_OK) {
+            errors++;
+            continue;
+        }
+        int64_t now = esp_timer_get_time();
+        uint32_t magic = PPG_MAGIC, ts = (uint32_t)now;
+        uint16_t rate = PPG_RATE_HZ, flags = ovf > 0 ? 1 : 0;
+        memcpy(&pkt[0], &magic, 4);
+        pkt[4] = csi_collector_get_node_id();
+        pkt[5] = 1;            /* MAX3010x */
+        pkt[6] = (uint8_t)n;
+        pkt[7] = 2;            /* red, IR */
+        memcpy(&pkt[8], &seq, 4);
+        memcpy(&pkt[12], &ts, 4);
+        memcpy(&pkt[16], &rate, 2);
+        memcpy(&pkt[18], &flags, 2);
+        for (int i = 0; i < n; i++) {
+            const uint8_t *p = &raw[i * 6];
+            uint32_t red = (((uint32_t)p[0] << 16) | ((uint32_t)p[1] << 8) | p[2]) & 0x3FFFF;
+            uint32_t ir  = (((uint32_t)p[3] << 16) | ((uint32_t)p[4] << 8) | p[5]) & 0x3FFFF;
+            memcpy(&pkt[20 + i * 8], &red, 4);
+            memcpy(&pkt[24 + i * 8], &ir, 4);
+        }
+        stream_sender_send_priority(pkt, 20 + (size_t)n * 8);  /* ~20 small packets/s */
+        seq++;
+    }
+}
+
+esp_err_t medisense_ppg_init(void)
+{
+    i2c_master_bus_config_t bus_cfg = {
+        .i2c_port = I2C_NUM_0,
+        .sda_io_num = MEDISENSE_PPG_SDA_GPIO,
+        .scl_io_num = MEDISENSE_PPG_SCL_GPIO,
+        .clk_source = I2C_CLK_SRC_DEFAULT,
+        .glitch_ignore_cnt = 7,
+        .flags.enable_internal_pullup = true,  /* most breakout boards also have their own */
+    };
+    esp_err_t err = i2c_new_master_bus(&bus_cfg, &s_bus);
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "I2C bus init failed: %s", esp_err_to_name(err));
+        return err;
+    }
+    if (i2c_master_probe(s_bus, PPG_ADDR, 50) != ESP_OK) {
+        ESP_LOGI(TAG, "No pulse sensor on I2C (SDA=%d, SCL=%d)", MEDISENSE_PPG_SDA_GPIO, MEDISENSE_PPG_SCL_GPIO);
+        i2c_del_master_bus(s_bus);
+        s_bus = NULL;
+        return ESP_ERR_NOT_FOUND;
+    }
+    i2c_device_config_t dev_cfg = {
+        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+        .device_address = PPG_ADDR,
+        .scl_speed_hz = 400000,
+    };
+    err = i2c_master_bus_add_device(s_bus, &dev_cfg, &s_dev);
+    if (err != ESP_OK) {
+        return err;
+    }
+    uint8_t part = 0;
+    if (rd(REG_PART_ID, &part, 1) != ESP_OK || part != PART_ID_MAX3010X) {
+        ESP_LOGW(TAG, "Device at 0x57 is not a MAX3010x (part id 0x%02x)", part);
+        return ESP_ERR_NOT_SUPPORTED;
+    }
+    wr(REG_MODE_CONFIG, 0x40);            /* reset */
+    vTaskDelay(pdMS_TO_TICKS(10));
+    wr(REG_FIFO_CONFIG, 0x5F);            /* average 4, roll over, almost-full at 17 free */
+    wr(REG_SPO2_CONFIG, 0x2F);            /* 4096 nA range, 400 sps, 411 us (18 bit) */
+    wr(REG_LED1_PA, 0x24);                /* red ~7 mA */
+    wr(REG_LED2_PA, 0x24);                /* IR ~7 mA */
+    wr(REG_FIFO_WR_PTR, 0);
+    wr(REG_OVF_COUNTER, 0);
+    wr(REG_FIFO_RD_PTR, 0);
+    err = wr(REG_MODE_CONFIG, 0x03);      /* SpO2 mode: red + IR */
+    if (err != ESP_OK) {
+        return err;
+    }
+    if (xTaskCreatePinnedToCore(ppg_task, "ms_ppg", 4096, NULL, 4, NULL, 0) != pdPASS) {
+        return ESP_ERR_NO_MEM;
+    }
+    ESP_LOGI(TAG, "Pulse sensor MAX3010x found: streaming red+IR at %d Hz", PPG_RATE_HZ);
+    return ESP_OK;
+}
